{
  // Launch configurations for opening the REPOSITORY ROOT in VS Code.
  // DeenTime/.vscode/launch.json holds the same configurations for people who
  // open the DeenTime/ folder directly; keep the two files in sync.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DeenTime API",
      "type": "node-terminal",
      "request": "launch",
      "command": "dotnet run --project backend/DeenTime.Api/DeenTime.Api.csproj --no-launch-profile -- --urls http://localhost:8080",
      "cwd": "${workspaceFolder}/DeenTime",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      // NestJS backend for local development. `npm run dev` (backend-node/scripts/dev.mjs)
      // loads DeenTime/.env, generates an ephemeral signing key and super-user password
      // when they are not set, regenerates the Prisma client and runs `nest start --watch`.
      // PostgreSQL must be running with the `deentime` database (see scripts/start-local.*).
      // The JavaScript debug terminal auto-attaches, so breakpoints in src/**/*.ts work.
      // PORT 8080 matches the Angular proxy (proxy.conf.json) and environment.ts.
      "name": "DeenTime Node API",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/DeenTime/backend-node",
      "env": {
        "PORT": "8080"
      }
    },
    {
      "name": "DeenTime Frontend",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm start -- --host localhost --port 4200",
      "cwd": "${workspaceFolder}/DeenTime/frontend/deentime-web"
    }
  ],
  "compounds": [
    {
      "name": "DeenTime API + Frontend",
      "configurations": [
        "DeenTime API",
        "DeenTime Frontend"
      ],
      "stopAll": true
    },
    {
      "name": "DeenTime Node API + Frontend",
      "configurations": [
        "DeenTime Node API",
        "DeenTime Frontend"
      ],
      "stopAll": true
    }
  ]
}
