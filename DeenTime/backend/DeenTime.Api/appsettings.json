    "ReplyTo": ""
  },
  "GooglePlaces": {
    "Enabled": false,
    "ApiKey": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.deentime.com",
      "http://localhost:4200",
      "http://127.0.0.1:4200",
      "capacitor://localhost",
      "tauri://localhost"
