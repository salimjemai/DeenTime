  },
  "Storage": {
    "ConnectionString": "",
    "Container": "deentime",
    "CdnBase": ""
  },
  "IslamicContent": {
    "QuranBaseUrl": "https://api.alquran.cloud/v1/",
    "AlAdhanBaseUrl": "https://api.aladhan.com/v1/",
