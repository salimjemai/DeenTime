{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=deentime;Username=postgres;Password=postgres"
  },
  "Auth": {
    "Issuer": "deentime",
    "Audience": "deentime-api",
    "SigningKey": ""
  },
  "Captcha": {
    "Enabled": false,
    "SiteKey": "",
    "SecretKey": "",
    "ExpectedHostnames": []
  },
  "EmailDelivery": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "",
