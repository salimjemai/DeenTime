# Copy these values into your shell or a local .env file that is not committed.
# scripts/start-local.sh generates the two local-only values when they are unset.
DEENTIME_AUTH_SIGNING_KEY=
# The IqamaTime administrator (super user) account. The email and password here are
# authoritative: changing them and restarting the API renames the account or rotates
# its password.
DEENTIME_SUPERUSER_EMAIL=salim_jemai@yahoo.com
DEENTIME_SUPERUSER_PASSWORD=
# Contact shown on the sign-in page for masjids that need an invitation or help.
DEENTIME_SUPPORT_EMAIL=salim_jemai@yahoo.com
# Optional: keep blank to show Hadith as not configured without exposing a provider key.
DEENTIME_HADITH_API_KEY=
