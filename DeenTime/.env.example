# Copy these values into your shell or a local .env file that is not committed.
# scripts/start-local.sh generates the two local-only values when they are unset.
DEENTIME_AUTH_SIGNING_KEY=
DEENTIME_SUPERUSER_PASSWORD=
# Optional: keep blank to show Hadith as not configured without exposing a provider key.
DEENTIME_HADITH_API_KEY=
