# Copy to /etc/deentime/deentime.env on the server (owned by root, chmod 600)
# and fill in the secrets. systemd loads it via EnvironmentFile, so use plain
# KEY=value lines (no `export`; quote only values that contain spaces).

ConnectionStrings__Default=Host=127.0.0.1;Port=5432;Database=iqama;Username=iqama_user;Password=CHANGE_ME

Auth__Issuer=iqamatime-staging
Auth__Audience=iqamatime-api
Auth__SigningKey=CHANGE_ME_64_HEX_CHARS

# Public origin of the site. Switch to https://<domain> once HTTPS is enabled
# (see README.md "HTTPS").
Frontend__PublicBaseUrl=http://70.36.101.120
Cors__AllowedOrigins__0=http://70.36.101.120

# Cloudflare Turnstile. Disabled until the site has a real hostname; the site
# key is public, the secret stays only here.
Captcha__Enabled=false
Captcha__SiteKey=CHANGE_TO_TURNSTILE_SITE_KEY
Captcha__SecretKey=CHANGE_TO_TURNSTILE_SECRET_KEY
Captcha__ExpectedHostnames__0=CHANGE_TO_DOMAIN

# SMTP mailbox used for verification and invitation emails.
EmailDelivery__Enabled=false
# With delivery disabled, log verification/invitation links to the journal so
# accounts can be activated: journalctl -u deentime-api | grep "URL for"
EmailDelivery__LogLinksWhenDisabled=true
EmailDelivery__Host=CHANGE_TO_MAIL_SERVER_HOST
EmailDelivery__Port=587
EmailDelivery__UseSsl=true
EmailDelivery__Username=CHANGE_TO_MAILBOX_USER
EmailDelivery__Password=CHANGE_TO_MAILBOX_PASSWORD
EmailDelivery__FromAddress=CHANGE_TO_FROM_ADDRESS
EmailDelivery__FromName=IqamaTime
EmailDelivery__ReplyTo=CHANGE_TO_FROM_ADDRESS

# Google Places (New) server key. Restrict it to the server IP and Places API.
GooglePlaces__Enabled=false
GooglePlaces__ApiKey=CHANGE_TO_GOOGLE_PLACES_SERVER_KEY

SuperUser__Email=salimjemai2015@gmail.com
SuperUser__Password=CHANGE_TO_A_STRONG_UNIQUE_PASSWORD
SuperUser__OrgName=IqamaTime
SuperUser__OrgEmail=salimjemai2015@gmail.com
SuperUser__WebsiteUrl=http://70.36.101.120
SuperUser__TimezoneId=America/Chicago

IslamicContent__HadithApiKey=
