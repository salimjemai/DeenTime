# Copy to ~/deentime/.env.staging on the server and fill in the secrets.
# chmod 600 the real file. systemd loads it via EnvironmentFile, so use
# plain KEY=value lines (no `export`, no quotes needed unless the value
# contains spaces).

# Where OpenLiteSpeed serves the site from (read by deploy-staging.sh).
DEENTIME_WEB_ROOT=/home/iqama.momyum.com/public_html

ConnectionStrings__Default=Host=127.0.0.1;Port=5432;Database=iqama;Username=iqama_user;Password=CHANGE_ME

Auth__Issuer=iqamatime-staging
Auth__Audience=iqamatime-api
Auth__SigningKey=CHANGE_ME_64_HEX_CHARS

Frontend__PublicBaseUrl=https://iqama.momyum.com
Cors__AllowedOrigins__0=https://iqama.momyum.com

# Cloudflare Turnstile. The site key is public; the secret stays only here.
Captcha__Enabled=true
Captcha__SiteKey=CHANGE_TO_TURNSTILE_SITE_KEY
Captcha__SecretKey=CHANGE_TO_TURNSTILE_SECRET_KEY
Captcha__ExpectedHostnames__0=iqama.momyum.com

# CyberPanel mailbox used for verification and invitation emails.
EmailDelivery__Enabled=true
EmailDelivery__Host=CHANGE_TO_MAIL_SERVER_HOST
EmailDelivery__Port=587
EmailDelivery__UseSsl=true
EmailDelivery__Username=verify@iqama.momyum.com
EmailDelivery__Password=CHANGE_TO_MAILBOX_PASSWORD
EmailDelivery__FromAddress=verify@iqama.momyum.com
EmailDelivery__FromName=IqamaTime
EmailDelivery__ReplyTo=verify@iqama.momyum.com

# Google Places (New) server key. Restrict it to the server IP and Places API.
GooglePlaces__Enabled=true
GooglePlaces__ApiKey=CHANGE_TO_GOOGLE_PLACES_SERVER_KEY

SuperUser__Email=salimjemai2015@gmail.com
SuperUser__Password=CHANGE_TO_A_STRONG_UNIQUE_PASSWORD
SuperUser__OrgName=IqamaTime
SuperUser__OrgEmail=salimjemai2015@gmail.com
SuperUser__WebsiteUrl=https://iqama.momyum.com
SuperUser__TimezoneId=America/Chicago

IslamicContent__HadithApiKey=
