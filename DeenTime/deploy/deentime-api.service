# System-level systemd unit for the DeenTime API on the plain-Ubuntu staging box.
# Installed to /etc/systemd/system/deentime-api.service by deploy-staging.sh on
# every release. Secrets live in /etc/deentime/deentime.env (chmod 600, root).

[Unit]
Description=DeenTime API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=deentime
Group=deentime
WorkingDirectory=/opt/deentime/current/api
ExecStart=/usr/bin/node /opt/deentime/current/api/dist/main.js
EnvironmentFile=/etc/deentime/deentime.env
EnvironmentFile=-/opt/deentime/current/release.env
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
Environment=ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
Environment=NODE_ENV=production
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
