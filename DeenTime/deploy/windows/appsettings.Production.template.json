{
  "Urls": "http://127.0.0.1:8080",
  "ConnectionStrings": {
    "Default": "Host=127.0.0.1;Port=5432;Database=deentime;Username=deentime;Password=__DB_PASSWORD__"
  },
  "Auth": {
    "Issuer": "iqamatime",
    "Audience": "iqamatime-api",
    "SigningKey": "__SIGNING_KEY__"
  },
  "Frontend": { "PublicBaseUrl": "__PUBLIC_URL__" },
  "Cors": { "AllowedOrigins": [ "__PUBLIC_URL__" ] },
  "Captcha": { "Enabled": false },
  "EmailDelivery": { "Enabled": false, "LogLinksWhenDisabled": true },
  "GooglePlaces": { "Enabled": false },
  "SuperUser": {
    "Email": "__SUPERUSER_EMAIL__",
    "Password": "__SUPERUSER_PASSWORD__",
    "OrgName": "IqamaTime",
    "OrgEmail": "__SUPERUSER_EMAIL__",
    "WebsiteUrl": "__PUBLIC_URL__",
    "TimezoneId": "America/Chicago"
  },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "System": "Warning" } },
    "WriteTo": [ { "Name": "File", "Args": { "path": "C:\\DeenTime\\logs\\api-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 } } ]
  }
}
