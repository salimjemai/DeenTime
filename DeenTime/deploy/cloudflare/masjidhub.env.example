# Settings of the MasjidHub API when it runs as the origin behind the Cloudflare Tunnel.
#
# `masjidhub-origin.ps1 deploy` copies this file to C:\MasjidHub\masjidhub.env on first
# use and fills in the two __GENERATED__ values. That copy is the only place production
# secrets live: it is outside the repository and readable by your Windows account only.
# Plain KEY=value lines; restart the API after editing (masjidhub-origin.ps1 restart).

# Signs sign-in tokens. Changing it signs everyone out.
Auth__SigningKey=__GENERATED__

# The Cloudflare Pages worker sends this key (its ORIGIN_PROXY_KEY secret) with every
# request, which is what lets the API trust the visitor address in X-MasjidHub-Client-IP
# for rate limits and Turnstile. The tunnel hostname is public, so do not leave it empty.
Proxy__ClientIpHeader=X-MasjidHub-Client-IP
Proxy__SharedKey=__GENERATED__

# Public address of the site: used in emails, embed codes, iframe URLs and API redirects.
Frontend__PublicBaseUrl=__PUBLIC_URL__
Cors__AllowedOrigins__0=__PUBLIC_URL__

# PostgreSQL. Without this line the API uses appsettings.json (local database "deentime"
# as postgres/postgres). Prefer a dedicated role with its own password:
# ConnectionStrings__Default=Host=127.0.0.1;Port=5432;Database=deentime;Username=masjidhub;Password=CHANGE_ME

# Cloudflare Turnstile on sign-in and registration. Add __PUBLIC_HOST__ to the widget's
# hostnames in the Cloudflare dashboard before enabling it.
Captcha__Enabled=false
# Captcha__SiteKey=
# Captcha__SecretKey=
# Captcha__ExpectedHostnames__0=__PUBLIC_HOST__

# SMTP for verification, invitation and password-reset emails. While disabled, the
# links are written to the API log and invitation links are shown to the administrator.
EmailDelivery__Enabled=false
EmailDelivery__LogLinksWhenDisabled=true
EmailDelivery__FromName=MasjidHub
# EmailDelivery__Host=
# EmailDelivery__Port=587
# EmailDelivery__UseSsl=true
# EmailDelivery__Username=
# EmailDelivery__Password=
# EmailDelivery__FromAddress=
# EmailDelivery__ReplyTo=

# Contact shown on the sign-in page.
# Support__Email=

# The administrator account. Leave these out to keep the account already in the
# database untouched. When set they are authoritative: every start renames the account
# to this email and resets its password to this value.
# SuperUser__Email=
# SuperUser__Password=

# Optional providers.
# GooglePlaces__Enabled=true
# GooglePlaces__ApiKey=
# IslamicContent__HadithApiKey=
